{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://banklens.dev/schemas/bank_financials.silver.json",
  "title": "bank_financials (Silver)",
  "description": "One normalised row per bank per quarter. Amounts in actual USD (converted from FDIC thousands). This is the Phase-1 subset; the full contract adds loan composition and capital fields.",
  "type": "object",
  "required": ["cert_number", "quarter", "filing_date", "total_assets", "total_deposits"],
  "properties": {
    "cert_number": { "type": "integer", "description": "FDIC certificate number (primary bank identity)" },
    "cik": { "type": ["integer", "null"], "description": "SEC CIK, if the bank is a public filer (crosswalk)" },
    "rssd_id": { "type": ["integer", "null"], "description": "Fed RSSD ID (crosswalk linchpin)" },
    "name": { "type": ["string", "null"] },
    "state": { "type": ["string", "null"], "maxLength": 2 },
    "quarter": { "type": "string", "pattern": "^[0-9]{4}Q[1-4]$" },
    "filing_date": { "type": "string", "format": "date" },
    "restated_flag": { "type": "boolean", "default": false },
    "total_assets": { "type": ["number", "null"], "minimum": 0 },
    "total_deposits": { "type": ["number", "null"], "minimum": 0 },
    "domestic_deposits": { "type": ["number", "null"], "minimum": 0 },
    "insured_deposits": { "type": ["number", "null"], "minimum": 0 },
    "uninsured_deposits": { "type": ["number", "null"] },
    "total_loans_gross": { "type": ["number", "null"], "minimum": 0 },
    "total_loans_net": { "type": ["number", "null"], "minimum": 0 },
    "total_equity": { "type": ["number", "null"] }
  },
  "additionalProperties": true
}
