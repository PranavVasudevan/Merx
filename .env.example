# Copy to .env and fill in. NEVER commit the real .env.
# Phase 1 needs NONE of these (FDIC is public/no-auth) — they arrive with later phases.

# ---- API keys (later phases) ----
FRED_API_KEY=                      # https://fred.stlouisfed.org/docs/api/api_key.html
SEC_EDGAR_USER_AGENT=BankLens/0.1 (contact=you@example.org)   # SEC requires an identifying UA

# ---- Tiingo (real EOD price candles for the quant terminal) ----
# Free tier, no card, but genuinely requires a key (unlike FDIC/SEC/Fed, which are
# keyless) — get one at https://api.tiingo.com/account/api/token. 250 calls/day,
# 50 symbols/hour. Needed by scripts/land_market_data.ps1 and the get_price_candles
# / get_market_snapshot MCP tools.
TIINGO_API_KEY=

# ---- Local infra (platform/docker/docker-compose.dev.yml) ----
# POSTGRES_PORT is the HOST port; defaults to 55432 because 5432 is commonly
# already taken by a native Postgres install (it was, on the reference dev
# machine — a different project's Windows service). Container-internal port is
# always 5432 regardless (see docker-compose.dev.yml / K8s manifests).
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_USER=banklens
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=banklens
CLICKHOUSE_USER=banklens
CLICKHOUSE_PASSWORD=change_me_locally
MINIO_ROOT_USER=banklens
MINIO_ROOT_PASSWORD=change_me_locally
# Grafana (http://localhost:3000) — anonymous Viewer access is also enabled for
# local-dev convenience (GF_AUTH_ANONYMOUS_ENABLED in docker-compose.dev.yml);
# these creds are only for the admin/edit role.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_locally
# Keycloak (http://localhost:8081) — the realm/client/roles/test-users are all
# scripted via platform/auth/keycloak/banklens-realm.json; these creds are only
# for the Keycloak admin console itself, not the app's own users (see that file
# for the two test users: viewer1/viewer123, analyst1/analyst123).
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_locally

# ---- REST bridge auth (services/api-gateway/src/auth.py) ----
# Real OIDC (Keycloak) + OPA gating — see platform/auth/README.md. Defaults
# below already match docker-compose.dev.yml, so these only need setting if
# you're pointing at non-default Keycloak/OPA locations.
# Set to false for a quick local dev loop without Keycloak/OPA running.
BANKLENS_AUTH_ENABLED=true
KEYCLOAK_ISSUER=http://localhost:8081/realms/banklens
OPA_URL=http://localhost:8181/v1/data/banklens/allow

# ---- Agent fleet (Phase 6) — provider selection ----
# This project has a hard $0 spending rule. Default is "ollama" (free, local,
# already wired up) — only change this if you deliberately want to spend money
# (anthropic) or use an external free-tier API (gemini).
BANKLENS_LLM_PROVIDER=ollama

# ---- Ollama (default provider — free, local, zero installs beyond Ollama itself) ----
OLLAMA_MODEL=llama3.2:1b           # confirmed working; qwen2.5-coder:3b is nominally
                                    # sharper but was garbled on this machine — re-pull
                                    # it (`ollama pull qwen2.5-coder:3b`) to try again
OLLAMA_HOST=http://localhost:11434

# ---- Gemini (optional — genuinely free tier, no card required) ----
# Get keys at https://aistudio.google.com/apikey. Same multi-key rotation pattern
# as project-matcher's gemini_keys.py: "1 main + 4 backups" = 5x the free quota.
# Any of these three forms works (all unioned/de-duplicated):
GEMINI_API_KEY=                    # the "main" key
GEMINI_API_KEY_1=                  # backup 1
GEMINI_API_KEY_2=                  # backup 2
GEMINI_API_KEY_3=                  # backup 3
GEMINI_API_KEY_4=                  # backup 4
# GEMINI_API_KEYS=key1,key2,key3,key4,key5   # or just one comma-separated list
GEMINI_MODEL=gemini-3.5-flash

# ---- Anthropic (optional — COSTS MONEY, off by default) ----
ANTHROPIC_API_KEY=
