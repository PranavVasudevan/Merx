# Copy to .env.local for a local override (Vite auto-loads .env.local, gitignored).
# Neither variable is required for local dev — both default to the localhost
# bridge/Keycloak started by platform/docker/docker-compose.dev.yml.

# The REST bridge this app calls (services/api-gateway/src/bridge_server.py).
# Set this to your deployed bridge URL for a non-localhost build, e.g.
# VITE_API_BASE=https://api.banklens.example.com/api
VITE_API_BASE=http://localhost:8791/api

# OIDC provider for login (see src/auth.ts). Keycloak by default (derived from
# VITE_KEYCLOAK_URL below); set VITE_OIDC_AUTHORITY/VITE_OIDC_CLIENT_ID
# directly to point this at any other standards-compliant OIDC provider
# (Auth0, Clerk, Supabase Auth free tiers all work) once the bridge side is
# also pointed at it (see the root .env.example's OIDC_ISSUER).
VITE_KEYCLOAK_URL=http://localhost:8081
# VITE_OIDC_AUTHORITY=https://your-tenant.auth0.com/
# VITE_OIDC_CLIENT_ID=banklens-web
# Dotted path (or an exact top-level claim key) locating roles inside the
# decoded access token. Must match the bridge's OIDC_ROLES_CLAIM exactly —
# both sides decode the same token.
# VITE_OIDC_ROLES_CLAIM=realm_access.roles
